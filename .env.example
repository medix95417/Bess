# Run python3 scripts/configure.py to create .env with a random key.
SECRET_KEY=replace-with-at-least-50-random-characters-before-starting
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HTTPS=false
TRUST_PROXY=false
BIND_ADDRESS=127.0.0.1
PORT=8080
SEED_CONTENT=true
